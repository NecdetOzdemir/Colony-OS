<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.-->
<robot name="worker">
    <!--GROUPS: Representation of a set of joints and links.-->
    <group name="arm">
        <chain base_link="arm_base_link" tip_link="gripper_link"/>
    </group>
    
    <!--GROUP STATES: Purpose: Define a named state for a particular group-->
    <group_state name="home" group="arm">
        <joint name="joint1" value="0"/>
        <joint name="joint2" value="0"/>
        <joint name="joint3" value="0"/>
    </group_state>
    <group_state name="pick" group="arm">
        <joint name="joint1" value="0"/>
        <joint name="joint2" value="0.785"/>
        <joint name="joint3" value="0.785"/>
    </group_state>

    <!--VIRTUAL JOINT: Purpose: this element defines a virtual joint between a robot link and an external frame of reference-->
    <virtual_joint name="virtual_joint" type="planar" parent_frame="odom" child_link="base_link"/>

    <!--DISABLE COLLISIONS-->
    <disable_collisions link1="arm_base_link" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="arm_base_link" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="gripper_link" reason="Adjacent"/>
</robot>
