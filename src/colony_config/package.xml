<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>colony_config</name>
  <version>0.1.0</version>
  <description>
    Colony-OS merkezi konfigürasyon kütüphanesi.
    Tüm sistem parametreleri bu paketten çekilir.
  </description>

  <maintainer email="colony-os@example.com">Colony-OS Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <test_depend>ament_pep8</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
